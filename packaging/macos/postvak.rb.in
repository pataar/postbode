# Generated by .github/workflows/macos-app.yml in postvak-app/postvak from packaging/macos/postvak.rb.in; edits here are overwritten.
# Lines starting with @ADHOC@ are kept (marker stripped) for an ad hoc signed DMG and dropped for a notarized one.
cask "postvak" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/postvak-app/postvak/releases/download/v#{version}/postvak-#{version}-macos-universal.dmg"
  name "Postvak"
  desc "Fast, simple mail client with automatic mailbox rules"
  homepage "https://postvak.pataar.nl/"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app, the CLI and the MCP server share one daemon over one socket, and an older client refuses a newer
  # daemon, so the cask's binary and the formula's must not both be installed.
  conflicts_with formula: "postvak"
  depends_on macos: ">= :big_sur"

  app "Postvak.app"
  binary "#{appdir}/Postvak.app/Contents/MacOS/postvak"

@ADHOC@  # Signed ad hoc, not notarized: without clearing the quarantine flag Homebrew sets, Gatekeeper refuses the app.
@ADHOC@  postflight do
@ADHOC@    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Postvak.app"]
@ADHOC@  end

  # Paths from src/paths.rs (directories::ProjectDirs on macOS) and src/daemon/service.rs (the launchd agent).
  # Passwords stay in the login Keychain; remove them with Keychain Access.
  zap launchctl: "io.github.postvak_app.postvak",
      trash:     [
        "~/Library/Application Support/postvak",
        "~/Library/Caches/postvak",
        "~/Library/LaunchAgents/io.github.postvak_app.postvak.plist",
      ]
end
