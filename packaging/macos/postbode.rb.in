# Generated by .github/workflows/macos-app.yml in pataar/postbode from packaging/macos/postbode.rb.in; edits here are overwritten.
# Lines starting with @ADHOC@ are kept (marker stripped) for an ad hoc signed DMG and dropped for a notarized one.
cask "postbode" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/pataar/postbode/releases/download/v#{version}/postbode-#{version}-macos-universal.dmg"
  name "Postbode"
  desc "Fast, simple mail client with automatic mailbox rules"
  homepage "https://postbode.pataar.nl/"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app, the CLI and the MCP server share one daemon over one socket, and an older client refuses a newer
  # daemon, so the cask's binary and the formula's must not both be installed.
  conflicts_with formula: "postbode"
  depends_on macos: ">= :big_sur"

  app "Postbode.app"
  binary "#{appdir}/Postbode.app/Contents/MacOS/postbode"

@ADHOC@  # Signed ad hoc, not notarized: without clearing the quarantine flag Homebrew sets, Gatekeeper refuses the app.
@ADHOC@  postflight do
@ADHOC@    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Postbode.app"]
@ADHOC@  end

  # Paths from src/paths.rs (directories::ProjectDirs on macOS) and src/daemon/service.rs (the launchd agent).
  # Passwords stay in the login Keychain; remove them with Keychain Access.
  zap launchctl: "nl.pataar.postbode",
      trash:     [
        "~/Library/Application Support/postbode",
        "~/Library/Caches/postbode",
        "~/Library/LaunchAgents/nl.pataar.postbode.plist",
      ]
end
