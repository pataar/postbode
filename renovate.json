{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesMonthly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [".github/workflows/release.yml"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "dist is upgraded together with cargo-dist-version in dist-workspace.toml, with `dist init`",
      "matchManagers": ["mise"],
      "matchPackageNames": ["axodotdev/cargo-dist", "github:axodotdev/cargo-dist"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "draftPR": true
    },
    {
      "description": "rust-toolchain.toml and .mise.toml move together",
      "matchDepNames": ["rust"],
      "matchManagers": ["mise", "rust-toolchain"],
      "groupName": "Rust toolchain"
    }
  ]
}
